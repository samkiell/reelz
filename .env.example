# Reelz local-first defaults. Never commit actual tokens or credentials.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
# Generate a random high-entropy secret for signing/encrypting sessions.
AUTH_SECRET=

# Local model (installed already on user's laptop; check with ollama list)
SCRIPT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional hosted fallback. App must work with this EMPTY.
GROQ_API_KEY=
GROQ_MODEL=

# Required mode must be keyless: hyperframes-local
DEFAULT_RENDERER=hyperframes-local
RENDER_CONCURRENCY=1
RENDERER_BASE_URL=http://127.0.0.1:3123
PEXELS_API_KEY=

# Local output
STORAGE_ROOT=./storage
MAX_STORAGE_GB=30

# Local Kokoro defaults
KOKORO_VOICE=af_heart
KOKORO_LANG_CODE=a
KOKORO_SPEED_SHORTS=1.15

# YouTube OAuth (P1 only, must not block baseline app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
